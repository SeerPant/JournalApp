@page "/calendarview"
@using JournalApp.Components.Models
@using JournalApp.Components.Service
@inject IJournalEntryService JournalService
@inject IUserService UserService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4" Style="color: #38182F;">Your entries</MudText>

    @if (isLoading)
    {
        <MudProgressCircular Style="color:#38182F;" Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="2">
            <div id="calendar"></div>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<JournalEntry> allEntries = new();
    private bool isLoading = true;
    private int currentUserId = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await UserService.GetUserAsync();
            if (user != null)
            {
                currentUserId = user.userID;
            }
            allEntries = await JournalService.GetAllEntriesAsync(currentUserId);
            System.Diagnostics.Debug.WriteLine($"Loaded {allEntries.Count} entries");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading calendar: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isLoading)
        {
            try
            {
                await Task.Delay(100);

                var eventsList = allEntries.Select(e => new Dictionary<string, object>
                {
                    ["title"] = e.Title,
                    ["start"] = e.CreatedAt.ToString("yyyy-MM-dd"),
                    ["id"] = e.EntryID.ToString()
                }).ToArray();

                System.Diagnostics.Debug.WriteLine($"Passing {eventsList.Length} events to calendar");
                foreach (var evt in eventsList)
                {
                    System.Diagnostics.Debug.WriteLine($"Event: {evt["title"]} on {evt["start"]}");
                }

                await JSRuntime.InvokeVoidAsync("initializeCalendar", (object)eventsList);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error initializing calendar: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("destroyCalendar");
        }
        catch
        {
            //destroyed calendar
        }
    }
}