@page "/journals/view/{Id:int}"
@using JournalApp.Components.Models
@using JournalApp.Components.Service
@inject IJournalEntryService JournalService
@inject MoodService MoodService
@inject TagService TagService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@inject IUserService UserService

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (entry != null)
    {
        <MudPaper Class="pa-6" Elevation="3">
            <MudGrid>
                <MudItem xs="12" Class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h4">@entry.Title</MudText>
                    <div>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       OnClick="EditEntry"
                                       Size="Size.Large" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="DeleteEntry"
                                       Size="Size.Large" />
                    </div>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                        Date: @entry.CreatedAt.ToString("MMMM dd, yyyy")
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                        Created: @entry.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                    </MudText>
                </MudItem>

                @if (entry.UpdateAt != entry.CreatedAt)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" />
                            Last Updated: @entry.UpdateAt.ToString("MMM dd, yyyy h:mm tt")
                        </MudText>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudDivider />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-2">Mood</MudText>
                    <MudChipSet T="string">
                        @if (entry.PrimaryMoodID.HasValue && primaryMood != null)
                        {
                            <MudChip T="string"
                                     Color="GetMoodColor(primaryMood.Category)"
                                     Size="Size.Medium"
                                     Icon="@Icons.Material.Filled.Mood">
                                @primaryMood.MoodName (Primary)
                            </MudChip>
                        }

                        @if (entry.SecondaryMoodFirstID.HasValue && secondaryMood1 != null)
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Medium">
                                @secondaryMood1.MoodName
                            </MudChip>
                        }

                        @if (entry.SecondaryMoodSecondID.HasValue && secondaryMood2 != null)
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Medium">
                                @secondaryMood2.MoodName
                            </MudChip>
                        }
                    </MudChipSet>
                </MudItem>

                @if (tags.Any())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-2">Tags</MudText>
                        <MudChipSet T="string">
                            @foreach (var tag in tags)
                            {
                                <MudChip T="string"
                                         Color="Color.Primary"
                                         Size="Size.Small"
                                         Icon="@Icons.Material.Filled.Tag">
                                    @tag.TagName
                                </MudChip>
                            }
                        </MudChipSet>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudDivider />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-3">Content</MudText>
                    <MudPaper Class="pa-4" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                        <MudText Typo="Typo.body1" Style="white-space: pre-wrap; line-height: 1.8;">
                            @((MarkupString)entry.Content)
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Word Count: @entry.WordCount
                    </MudText>
                </MudItem>

                <MudItem xs="12" Class="d-flex gap-2 mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="BackToList">
                        Back to List
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="EditEntry">
                        Edit Entry
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Warning">
            Journal entry not found.
        </MudAlert>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="BackToList"
                   Class="mt-2">
            Back to List
        </MudButton>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private JournalEntry? entry;
    private Mood? primaryMood;
    private Mood? secondaryMood1;
    private Mood? secondaryMood2;
    private List<Tag> tags = new();

    protected override async Task OnInitializedAsync()
    {
        entry = await JournalService.GetEntryByIdAsync(Id);
        
        if (entry != null)
        {
            if (entry.PrimaryMoodID.HasValue)
                primaryMood = await MoodService.GetMoodByIdAsync(entry.PrimaryMoodID.Value);
            
            if (entry.SecondaryMoodFirstID.HasValue)
                secondaryMood1 = await MoodService.GetMoodByIdAsync(entry.SecondaryMoodFirstID.Value);
            
            if (entry.SecondaryMoodSecondID.HasValue)
                secondaryMood2 = await MoodService.GetMoodByIdAsync(entry.SecondaryMoodSecondID.Value);

            tags = await TagService.GetTagsForEntryAsync(entry.EntryID);
        }
    }

    private Color GetMoodColor(string category)
    {
        return category switch
        {
            "Positive" => Color.Success,
            "Negative" => Color.Error,
            _ => Color.Default
        };
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/journals");
    }

    private void EditEntry()
    {
        Navigation.NavigateTo($"/journals/edit/{Id}");
    }

    private async Task DeleteEntry()
    {
        var result = await JournalService.DeleteEntryAsync(Id);
        if (result)
        {
            Snackbar.Add("Entry deleted successfully", Severity.Success);
            Navigation.NavigateTo("/journals");
        }
        else
        {
            Snackbar.Add("Failed to delete entry", Severity.Error);
        }
    }
}