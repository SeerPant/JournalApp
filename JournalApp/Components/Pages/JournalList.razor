@page "/journals"
@using JournalApp.Components.Models
@using JournalApp.Components.Service
@inject MoodService MoodService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@inject IJournalEntryService JournalService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">My Journal Entries</MudText>
    
    <MudButton Variant="Variant.Filled" 
               Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateNewEntry"
               Class="mb-4">
        New Entry
    </MudButton>

    @if (entries.Any())
    {
        <MudGrid>
            @foreach (var entry in entries)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@entry.Title</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @entry.CreatedAt.ToString("MMM dd, yyyy")
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                @GetContentPreview(entry.Content)
                            </MudText>
                            
                            @if (entry.PrimaryMoodID.HasValue)
                            {
                                var moodName = GetMoodName(entry.PrimaryMoodID.Value);
                                if (!string.IsNullOrEmpty(moodName))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                        @moodName
                                    </MudChip>
                                }
                            }
                            
                            <MudText Typo="Typo.caption" Class="mt-2">
                                @entry.WordCount words
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Size="Size.Small" 
                                      Color="Color.Primary" 
                                      OnClick="@(() => ViewEntry(entry.EntryID))">
                                View
                            </MudButton>
                            <MudButton Size="Size.Small" 
                                      Color="Color.Secondary" 
                                      OnClick="@(() => EditEntry(entry.EntryID))">
                                Edit
                            </MudButton>
                            <MudButton Size="Size.Small" 
                                      Color="Color.Error" 
                                      OnClick="@(() => DeleteEntry(entry.EntryID))">
                                Delete
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudPagination Class="mt-4" 
                      Count="@totalPages" 
                      Selected="@currentPage" 
                      SelectedChanged="OnPageChanged"
                      Color="Color.Primary" />
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            No journal entries yet. Create your first entry!
        </MudAlert>
    }
</MudContainer>

@code {
    private List<JournalEntry> entries = new();
    private List<Mood> moods = new();
    private int currentPage = 1;
    private int pageSize = 6;
    private int totalPages = 1;
    private int currentUserId = 1;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserService.GetUserAsync();
        if (user != null)
        {
            currentUserId = user.userID;
        }

        moods = await MoodService.GetAllMoodsAsync();
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        entries = await JournalService.GetPagedEntriesAsync(currentUserId, currentPage, pageSize);
        var totalCount = await JournalService.GetTotalEntriesCountAsync(currentUserId);
        totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
        StateHasChanged();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadEntriesAsync();
    }

    private string GetContentPreview(string content)
    {
        var plainText = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", string.Empty);
        return plainText.Length > 100 ? plainText.Substring(0, 100) + "..." : plainText;
    }

    private string GetMoodName(int moodId)
    {
        var mood = moods.FirstOrDefault(m => m.MoodID == moodId);
        return mood?.MoodName ?? "";
    }

    private void CreateNewEntry()
    {
        Navigation.NavigateTo("/journals/create");
    }

    private void ViewEntry(int id)
    {
        Navigation.NavigateTo($"/journals/view/{id}");
    }

    private void EditEntry(int id)
    {
        Navigation.NavigateTo($"/journals/edit/{id}");
    }

    private async Task DeleteEntry(int id)
    {
        var result = await JournalService.DeleteEntryAsync(id);
        if (result)
        {
            Snackbar.Add("Entry deleted successfully", Severity.Success);
            await LoadEntriesAsync();
        }
        else
        {
            Snackbar.Add("Failed to delete entry", Severity.Error);
        }
    }
}