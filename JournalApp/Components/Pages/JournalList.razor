@page "/journals"
@using JournalApp.Components.Models
@using JournalApp.Components.Service
@inject MoodService MoodService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJournalEntryService JournalService
@using QuestPDF.Fluent
@using QuestPDF.Infrastructure
@using MudSize = MudBlazor.Size
@using MudColor = MudBlazor.Color
@* @using static QuestPDF.Infrastructure.PageSizes *@

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">My Journal Entries</MudText>

    <!-- Search Bar -->
    <MudTextField @bind-Value="searchKeyword"
                  Label="Search journals"
                  Placeholder="Search by title or content..."
                  Variant="Variant.Outlined"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  OnAdornmentClick="SearchEntries"
                  Class="mb-4" />

    <!-- Date Filter -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="5">
            <MudDatePicker Label="Start Date"
                           @bind-Date="startDate"
                           Variant="Variant.Outlined"
                           Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudDatePicker Label="End Date"
                           @bind-Date="endDate"
                           Variant="Variant.Outlined"
                           Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled"
                       Style="Background-Color: #38182F; color: white;"
                       FullWidth="true"
                       OnClick="FilterByDate">
                Filter
            </MudButton>
        </MudItem>
    </MudGrid>

    <div class="d-flex gap-2 mb-4">
        <MudButton Variant="Variant.Filled"
                   Style="Background-Color: #38182F; color: white;"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateNewEntry">
            New Entry
        </MudButton>

        @if (showExpButton)
        {
            <MudButton Variant="Variant.Filled"
                       Style="Background-Color: #4CAF50; color: white;"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="ExportToPDF"
                       Disabled="isExporting">
                @if (isExporting)
                {
                    <MudProgressCircular Size="MudSize.Small" Indeterminate="true" />
                    <span class="ml-2">Exporting...</span>
                }
                else
                {
                    <span>Export to PDF</span>
                }
            </MudButton>
        }
    </div>

    @if (entries.Any())
    {
        <MudGrid>
            @foreach (var entry in entries)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@entry.Title</MudText>
                                <MudText Typo="Typo.body2" Color="MudColor.Secondary">
                                    @entry.CreatedAt.ToString("MMM dd, yyyy")
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                @GetContentPreview(entry.Content)
                            </MudText>

                            @if (entry.PrimaryMoodID.HasValue)
                            {
                                var moodName = GetMoodName(entry.PrimaryMoodID.Value);
                                if (!string.IsNullOrEmpty(moodName))
                                {
                                    <MudChip T="string" Size="MudSize.Small" Style="background-color:#38182F; color: White">
                                        @moodName
                                    </MudChip>
                                }
                            }

                            <MudText Typo="Typo.caption" Class="mt-2">
                                @entry.WordCount words
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Size="MudSize.Small"
                                       Style="background-color:#330036; color: white; margin-right: 8px;"
                                       OnClick="@(() => ViewEntry(entry.EntryID))">
                                View
                            </MudButton>
                            <MudButton Size="MudSize.Small"
                                       Style="background-color:#330036; color: white; margin-right: 8px;"
                                       OnClick="@(() => EditEntry(entry.EntryID))">
                                Edit
                            </MudButton>
                            <MudButton Size="MudSize.Small"
                                       Style="background-color: red; color: white"
                                       OnClick="@(() => DeleteEntry(entry.EntryID))">
                                Delete
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudPagination Class="mt-4"
                       Count="@totalPages"
                       Selected="@currentPage"
                       SelectedChanged="OnPageChanged" />
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            No journal entries found.
        </MudAlert>
    }
</MudContainer>

<style>
    .mud-pagination .mud-pagination-item.mud-selected {
        background-color: #38182F !important;
        color: white !important;
    }

    .mud-pagination .mud-button-root.mud-selected {
        background-color: #38182F !important;
        color: white !important;
    }
</style>

@code {
    private List<JournalEntry> entries = new();
    private List<Mood> moods = new();
    private int currentPage = 1;
    private int pageSize = 6;
    private int totalPages = 1;
    private int currentUserId = 1;
    private string searchKeyword = string.Empty;
    private DateTime? startDate;
    private DateTime? endDate;
    private List<JournalEntry> filteredEntries = new();
    private bool showExpButton = false;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserService.GetUserAsync();
        if (user != null)
        {
            currentUserId = user.userID;
        }

        moods = await MoodService.GetAllMoodsAsync();
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        entries = await JournalService.GetPagedEntriesAsync(currentUserId, currentPage, pageSize);
        var totalCount = await JournalService.GetTotalEntriesCountAsync(currentUserId);
        totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
        StateHasChanged();
    }

    private async Task SearchEntries()
    {
        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            entries = await JournalService.SearchEntriesAsync(currentUserId, searchKeyword);
        }
        else
        {
            await LoadEntriesAsync();
        }
    }

    private async Task FilterByDate()
    {
        if (startDate.HasValue && endDate.HasValue)
        {
            entries = await JournalService.GetEntriesByDateRangeAsync(currentUserId, startDate.Value, endDate.Value);
            filteredEntries = entries;
            showExpButton = true;
            Snackbar.Add($"Filtered entries from {startDate.Value:MMM dd, yyyy} to {endDate.Value:MMM dd, yyyy}", Severity.Info);
        }
        else if (startDate.HasValue || endDate.HasValue)
        {
            Snackbar.Add("Please select both start and end dates", Severity.Warning);
        }
        else
        {
            await LoadEntriesAsync();
            showExpButton = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadEntriesAsync();
    }

    private string GetContentPreview(string content, int charLimit = 50)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "";

        var plainText = System.Text.RegularExpressions.Regex.Replace(content, "<[^>]*>", "");
        plainText = System.Net.WebUtility.HtmlDecode(plainText).Trim();

        return plainText.Length <= charLimit ? plainText : plainText.Substring(0, charLimit);
    }

    private string GetMoodName(int moodId)
    {
        var mood = moods.FirstOrDefault(m => m.MoodID == moodId);
        return mood?.MoodName ?? "";
    }

    private void CreateNewEntry()
    {
        Navigation.NavigateTo("/journals/create");
    }

    private void ViewEntry(int id)
    {
        Navigation.NavigateTo($"/journals/view/{id}");
    }

    private void EditEntry(int id)
    {
        Navigation.NavigateTo($"/journals/edit/{id}");
    }

    private async Task DeleteEntry(int id)
    {
        var result = await JournalService.DeleteEntryAsync(id);
        if (result)
        {
            Snackbar.Add("Entry deleted successfully", Severity.Success);
            await LoadEntriesAsync();
        }
        else
        {
            Snackbar.Add("Failed to delete entry", Severity.Error);
        }
    }

    private byte[] GeneratePDF(List<JournalEntry> entriesToExport)
    {
        using var stream = new MemoryStream();

        QuestPDF.Settings.License = LicenseType.Community;

        QuestPDF.Fluent.Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(QuestPDF.Helpers.PageSizes.A4);
                page.Margin(2, Unit.Centimetre);
                page.PageColor("#FFFFFF");
                page.DefaultTextStyle(x => x.FontSize(11));

                page.Header()
                    .Text($"Journal entries by date: \n{startDate:MMM dd, yyyy} - {endDate:MMM dd, yyyy}")
                    .SemiBold().FontSize(20).FontColor("#38182F");

                page.Content()
                    .PaddingVertical(1, Unit.Centimetre)
                    .Column(column =>
                    {
                        foreach (var entry in entriesToExport)
                        {
                            column.Item().Border(1).BorderColor("#38182F").Padding(10).Column(entryColumn =>
                            {
                                entryColumn.Item().Text(entry.Title).Bold().FontSize(14);
                                entryColumn.Item().PaddingTop(5).Text($"Date: {entry.CreatedAt:MMM dd, yyyy}").FontSize(10).FontColor("#666666");

                                if (entry.PrimaryMoodID.HasValue)
                                {
                                    var moodName = GetMoodName(entry.PrimaryMoodID.Value);
                                    if (!string.IsNullOrEmpty(moodName))
                                    {
                                        entryColumn.Item().PaddingTop(5).Text($"Mood: {moodName}").FontSize(10).FontColor("#38182F");
                                    }
                                }

                                var plainContent = StripHtmlTags(entry.Content);
                                entryColumn.Item().PaddingTop(10).Text(plainContent).FontSize(11).LineHeight(1.5f);

                                entryColumn.Item().PaddingTop(5).Text($"{entry.WordCount} words").FontSize(9).FontColor("#999999");
                            });

                            column.Item().PaddingVertical(10);
                        }
                    });

                page.Footer()
                    .AlignCenter()
                    .Text(x =>
                    {
                        x.Span("Page ");
                        x.CurrentPageNumber();
                        x.Span(" of ");
                        x.TotalPages();
                    });
            });
        }).GeneratePdf(stream);

        return stream.ToArray();
    }

    private async Task ExportToPDF()
    {
        try
        {
            isExporting = true;
            StateHasChanged();

            var pdfBytes = GeneratePDF(filteredEntries);
            var fileName = $"JournalExport_{startDate:yyyyMMdd}_to_{endDate:yyyyMMdd}.pdf";

            await SavePDFile(fileName, pdfBytes);

            Snackbar.Add("PDF exported successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
            System.Diagnostics.Debug.WriteLine($"Export error: {ex}");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task SavePDFile(string fileName, byte[] pdfBytes)
    {
        var savePicker = new Windows.Storage.Pickers.FileSavePicker();

        
        var window = Application.Current?.Windows[0]?.Handler?.PlatformView as Microsoft.UI.Xaml.Window;
        if (window != null)
        {
            var hwnd = WinRT.Interop.WindowNative.GetWindowHandle(window);
            WinRT.Interop.InitializeWithWindow.Initialize(savePicker, hwnd);
        }

        savePicker.SuggestedStartLocation = Windows.Storage.Pickers.PickerLocationId.DocumentsLibrary;
        savePicker.SuggestedFileName = fileName;
        savePicker.FileTypeChoices.Add("PDF Document", new List<string> { ".pdf" });

        var file = await savePicker.PickSaveFileAsync();
        if (file != null)
        {
            await Windows.Storage.FileIO.WriteBytesAsync(file, pdfBytes);
            Snackbar.Add($"PDF saved to {file.Path}", Severity.Success);
        }
    }

    private string StripHtmlTags(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return string.Empty;

        var plainText = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "");
        return System.Net.WebUtility.HtmlDecode(plainText).Trim();
    }
}