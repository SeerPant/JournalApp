@inherits LayoutComponentBase
@* //<MudThemeProvider /> *@
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Style="background-color: #38182F;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">My Journal</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Navigation</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            

            <MudNavLink Href="/home" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Home
            </MudNavLink>
            <MudNavLink Href="/journals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Book">
                My journals
            </MudNavLink>
            <MudNavLink Href="/calendarview" Icon="@Icons.Material.Filled.Checklist">
                Calendar view
            </MudNavLink>
            <MudNavLink Href="/journals/create" Icon="@Icons.Material.Filled.Add">
                New entry
            </MudNavLink>
            <MudNavLink Href="/analytics" Icon="@Icons.Material.Filled.AlignVerticalCenter">
                Journal analytics
            </MudNavLink> 
            
            
        </MudNavMenu>
        <MudSpacer/>
        <div class="pa-4">   
        <MudThemeProvider @bind-IsDarkMode="@_isDark" Theme="@CustomTheme" />
        <MudToggleIconButton @bind-Toggled="@_isDark" Icon="@Icons.Material.Filled.Brightness3" Color="@Color.Default"
                             ToggledIcon="@Icons.Material.Filled.BrightnessHigh" />
        </div>   
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    .mud-nav-link.active {
        background-color: transparent !important;
        color: inherit !important;
    }

    .mud-nav-link:hover {
        background-color: #F5F5F5 !important;
    }
</style>

@code {
    private bool _drawerOpen = true;
    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private bool _isDark;

    MudTheme CustomTheme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = Colors.Red.Lighten4,
                Secondary = Colors.Red.Lighten4,
                //AppbarBackground = Colors.DeepPurple.Darken3,
            },

            PaletteDark = new PaletteDark()
            {
                Primary = Colors.Indigo.Darken4,
                Secondary = Colors.Indigo.Darken4,
                //AppbarBackground = Colors.Blue.Darken3,
            }

        };
}