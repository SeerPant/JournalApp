<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Components.Layout.MainLayout)">
            <div class="pa-4">
                <MudText Typo="Typo.h4">Page Not Found</MudText>
                <MudText>Sorry, there's nothing at this address.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="mt-4">
                    Go Home
                </MudButton>
            </div>
        </LayoutView>
    </NotFound>
</Router>