@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText>@Content</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Confirm">Confirm</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudBlazor.IDialogReference? MudDialog { get; set; }

    [Parameter]
    public string Content { get; set; } = "Are you sure?";

    [Parameter]
    public Color Color { get; set; } = Color.Primary;

    private void Confirm()
    {
        MudDialog?.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog?.Close();
    }
}